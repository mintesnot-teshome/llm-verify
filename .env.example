# === REQUIRED ===
DATABASE_URL=sqlite+aiosqlite:///./benchmarker.db

# === AI PROVIDER API KEYS (add as needed) ===
# OPENAI_API_KEY=your-openai-key-here
# ANTHROPIC_API_KEY=your-anthropic-key-here
# SUSPECT_API_KEY=the-api-key-you-are-testing
# SUSPECT_API_BASE_URL=https://api.suspect-provider.com/v1

# === OPTIONAL ===
# Required by default for every /api/v1 endpoint.
API_ACCESS_KEY=replace-with-a-long-random-secret
# Set true only for isolated local development.
# ALLOW_UNAUTHENTICATED=false
# In-process limit per access key/client. Use an edge limiter in multi-worker production.
# API_REQUESTS_PER_MINUTE=60
# Exact custom API hosts, comma-separated. Required for generic/custom endpoints.
# ALLOWED_API_HOSTS=api.suspect-provider.com,localhost
# LOG_LEVEL=INFO
# BENCHMARK_TIMEOUT=30
# MAX_CONCURRENT_CALLS=5
